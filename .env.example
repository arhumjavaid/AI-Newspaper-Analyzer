# --- Gemini API (required for live analysis; key from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-api-key-here
MODEL=gemini-3.5-flash-lite
FALLBACK_MODEL=gemini-3.5-flash

APP_TITLE=AI Newspaper Analyzer
APP_URL=http://localhost:5173

# --- Client being monitored ---
CLIENT_NAME=K-Electric (KE)
CLIENT_ALIASES=KE,K-Electric,K Electric,KESC
CLIENT_DESCRIPTION=K-Electric (KE) is the sole vertically-integrated power utility supplying electricity to Karachi and surrounding areas in Pakistan. It frequently appears in the press around load-shedding, tariffs/NEPRA, billing, outages, safety incidents and infrastructure investment.

# --- Extraction tuning (optional) ---
MIN_TEXT_CHARS_PER_PAGE=120
RENDER_DPI=150
MAX_PAGES=30

# --- AVE estimate base ($) ---
AVE_BASE_USD=500
